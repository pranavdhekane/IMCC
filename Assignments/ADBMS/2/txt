CREATE DATABASE ASS_2;
USE ASS_2;

CREATE TABLE EMPLOYEE(
    Emp_no int,
    E_name varchar(50),
    E_address varchar(100),
    E_ph_no int,
    Dept_no int,
    Dept_name varchar(50),
    Job_id int,
    Designation varchar(50),
    Salary float,
    Joining_date date
);

