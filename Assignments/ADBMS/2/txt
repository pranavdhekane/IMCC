SELECT Emp_no, E_name, Salary
FROM EMPLOYEE
WHERE Designation like 'MANAGER';

SELECT *
FROM EMPLOYEE
WHERE Salary > 10000;

SELECT *
FROM EMPLOYEE
WHERE EXTRACT(YEAR FROM Joining_date) > 1981
ORDER BY Designation;

SELECT 
E_name, 
TIMESTAMPDIFF(YEAR, Joining_date, CURDATE()) AS Experience, 
Salary / 30
FROM EMPLOYEE;

SELECT * 
FROM EMPLOYEE
WHERE Designation IN ('CLERK', 'ANALYST');

SELECT *
FROM EMPLOYEE
WHERE Joining_date IN ('1981-05-01', '1981-12-03', '1981-12-17', '1980-01-19');

SELECT * 
FROM EMPLOYEE 
WHERE Dept_no = 10
OR Dept_no = 20;

SELECT E_name
FROM EMPLOYEE
WHERE E_name like 'S%';

SELECT MAX(Salary)
FROM EMPLOYEE;

SELECT E_name, SUBSTRING(E_name, 1, 5)
FROM EMPLOYEE
WHERE E_name like 'H____%'
AND Designation NOT IN ('MGR', 'PRESIDENT')
ORDER BY Salary;

SELECT MAX(Salary) AS MAX_SALARY,
MIN(Salary) AS MIN_SALARY,
MAX(TIMESTAMPDIFF(YEAR, Joining_date, CURDATE())) AS MAX_EXPERIANCE,
MIN(TIMESTAMPDIFF(YEAR, Joining_date, CURDATE())) AS MIN_EXPERIANCE
FROM EMPLOYEE;

SELECT SUM(Salary)
FROM EMPLOYEE;

SELECT AVG(Salary)
FROM EMPLOYEE
WHERE Dept_name = 'IT';

SELECT DISTINCT Salary
FROM EMPLOYEE;

DROP DATABASE ASS_2;
